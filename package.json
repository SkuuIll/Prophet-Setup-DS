{
    "name": "prophet-bot",
    "version": "2.9.0",
    "description": "Bot privado todo-en-uno para Prophet Gaming",
    "main": "index.js",
    "scripts": {
        "start": "node index.js",
        "dev": "node --watch index.js",
        "check": "node scripts/check_syntax.js",
        "test": "node --test",
        "verify": "npm run check && npm test",
        "audit:prod": "npm audit --omit=dev --audit-level=critical",
        "db:backup": "node scripts/backup_database.js",
        "deploy": "bash scripts/deploy.sh",
        "auto-update:install": "node scripts/install_auto_update.js",
        "server:audit": "node scripts/server_blueprint.js",
        "server:apply-blueprint": "node scripts/server_blueprint.js --apply"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@discord-player/extractor": "^7.2.0",
        "@discord-player/ffmpeg": "^7.1.0",
        "@discord/embedded-app-sdk": "^2.5.0",
        "@discordjs/opus": "^0.10.0",
        "@discordjs/voice": "^0.19.0",
        "@napi-rs/canvas": "^0.1.97",
        "axios": "^1.14.0",
        "better-sqlite3": "^12.8.0",
        "canvas": "^3.2.1",
        "discord-html-transcripts": "^3.2.0",
        "discord-player": "^7.2.0",
        "discord-player-youtubei": "^2.0.0",
        "discord.js": "^14.27.0",
        "dotenv": "^17.3.1",
        "node-fetch": "^3.3.2",
        "node-schedule": "^2.1.1",
        "qrcode": "^1.5.4",
        "shoukaku": "^4.3.0",
        "sodium-native": "^5.0.10",
        "youtube-dl-exec": "^3.1.9",
        "youtubei.js": "^17.2.0"
    }
}
