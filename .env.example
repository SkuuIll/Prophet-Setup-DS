# ═══ Prophet Bot v2.9 — Variables de Entorno ═══
# Copia este archivo a .env y completá tus propias claves.
# NUNCA commitees el .env real.

# Discord
DISCORD_TOKEN=tu_discord_bot_token_aqui
# Token de una segunda aplicación de Discord, solo para ProphetMusic
DISCORD_MUSIC_TOKEN=
GUILD_ID=tu_guild_id_aqui

# Discord Activities (Embedded App SDK) — OAuth2 de la MISMA app del bot
# Client ID = Application ID (portal). Client Secret = OAuth2 → Client Secret.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# URL pública HTTPS de juegos. Nunca usar localhost para usuarios remotos.
GAMES_BASE_URL=https://tu-dominio.example/games
GAMES_PORT=3850
# Cambiar a 127.0.0.1 solo si usás un reverse proxy HTTPS hacia el puerto 3850.
# Games detrás del proxy HTTPS local. No publicar directamente el puerto 3850.
GAMES_BIND_HOST=127.0.0.1
# Orígenes HTTPS adicionales de API/WS permitidos (separar por coma).
# Discord Activities y el mismo origen HTTPS están admitidos automáticamente.
# No usar wildcard ni HTTP público.
GAMES_CORS_ORIGINS=
# GET /api/games/session-info exige Authorization: Bearer <sessionToken>.
# No enviar tokens de sesión en query strings.
# Requerido para POST /api/games/create-token; generar con: openssl rand -hex 32
GAMES_INTERNAL_SECRET=
# Modo demo de WebSockets: solamente development + loopback local, deshabilitado en producción
GAMES_DEMO_ENABLED=false

# Lavalink
LAVALINK_PASSWORD=password_seguro_aqui
LAVALINK_BIND_ADDRESS=127.0.0.1
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# APIs de Juegos
PUBG_API_KEY=tu_pubg_api_key
TRACKER_API_KEY=tu_tracker_api_key

# AI (pueden convivir múltiples proveedores)
GEMINI_API_KEY=tu_gemini_api_key
GROQ_API_KEY=tu_groq_api_key
MISTRAL_API_KEY=tu_mistral_api_key
MISTRAL_API_KEY_2=otra_mistral_key_opcional
OPENROUTER_API_KEY=tu_openrouter_api_key
NVIDIA_API_KEY=tu_nvidia_api_key
OPENAI_API_KEY=tu_openai_api_key

# Twitch
TWITCH_CLIENT_ID=tu_twitch_client_id
TWITCH_CLIENT_SECRET=tu_twitch_client_secret

# Dashboard
JWT_SECRET=un_secreto_largo_y_aleatorio
ENCRYPTION_KEY=otra_clave_larga_y_aleatoria_de_32_bytes
HTTPS_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3789
